     "code": "# Observe and get candidates for the pen\nobs = observe()\nholder = obs[\"zones\"][\"magenta_holder\"]\nholder_center = holder[\"center\"]\nrim_height = holder[\"rim_height\"]\ntable_z = obs[\"table_z\"]\n\ncands = grasp_candidates(\"yellow_pen\")\n# Filter for geometry or highest score grasp across the short axis\ncand = sorted(cands, key=lambda c: c.get(\"score\", 0), reverse=True)[0]\ngrasp_res = grasp(cand)\n\nif grasp_res[\"holding_something\"]:\n    # Move above the holder safely cleared of the rim\n    safe_z = table_z + rim_height + 0.15\n    carry_to(holder_center[0], holder_center[1], height=safe_z - table_z)\n\n    # To place it upright into the holder, orient the held pen vertically.\n    # The pen is held horizontally along the gripper's side vector (approach x finger_axis).\n    # Gripper pointing down with horizontal finger axis holds the pen horizontally.\n    # To make the pen point vertically (down into the holder), we rotate the gripper so its 'side' points down,\n    # i.e. pitch the gripper 90 degrees (approach horizontal, finger_axis horizontal or vertical).\n    # Pitching: approach = [1, 0, 0] or [0, 1, 0] makes the side vector vertical ([0, 0, -1]).\n    # Check IK for horizontal approach:\n    # If approach = [1, 0, 0] and finger_axis = [0, 1, 0], then side = [0, 0, 1] (or [0, 0, -1] with finger_axis = [0, -1, 0]).\n    # When side is vertical, the pen is oriented vertically.\n    approach = [1, 0, 0]\n    finger_axis = [0, 1, 0]\n    ik_res = solve_ik(holder_center[0], holder_center[1], safe_z, approach=approach, finger_axis=finger_axis)\n    if not ik_res[\"reachable\"]:\n        approach = [0, 1, 0]\n        finger_axis = [1, 0, 0]\n\n    move_gripper(holder_center[0], holder_center[1], safe_z, approach=approach, finger_axis=finger_axis, path=\"line\")\n\n    # Lower down into the holder opening\n    lower_target_z = table_z + rim_height + 0.04\n    move_gripper(holder_center[0], holder_center[1], lower_target_z, approach=approach, finger_axis=finger_axis, path=\"line\")\n\n    # Release the pen so it drops/stands in the holder\n    open_gripper()\n    retreat(dz=0.15)\n    go_home()\n    check(\"yellow_pen\", \"magenta_holder\")",
