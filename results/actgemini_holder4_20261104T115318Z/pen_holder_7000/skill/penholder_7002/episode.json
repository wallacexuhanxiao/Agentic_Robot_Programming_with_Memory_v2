     "n": 1,
     "code": "# Grasp the red pen and insert it upright into magenta_holder\nobs = observe()\npen = obs[\"objects\"][\"red_pen\"]\nholder = obs[\"zones\"][\"magenta_holder\"]\ntable_z = obs[\"table_z\"]\n\n# Select a grasp candidate across the pen's short axis\ncandidates = grasp_candidates(\"red_pen\")\nbest_c = None\nfor c in candidates:\n    if c[\"fits_open_fingers\"] and c.get(\"squeeze_width\", 0) < 0.03:\n        if best_c is None or c[\"score\"] > best_c[\"score\"]:\n            best_c = c\n\nif best_c is None:\n    best_c = candidates[0]\n\nres = grasp(best_c)\nif not res[\"holding_something\"]:\n    close_gripper()\n    go_home()\nelse:\n    # Carry above the holder rim\n    hx, hy = holder[\"center\"][0], holder[\"center\"][1]\n    rim_h = holder.get(\"rim_height\", 0.08)\n    carry_to(hx, hy, height=rim_h + 0.15)\n\n    # Reorient gripper to hold pen vertically and insert into the holder\n    # When grasped top-down across short side, pen lies along side = approach x finger_axis.\n    # To orient pen vertically, rotate approach to be horizontal or orient pen downwards.\n    # We can pitch the gripper so the pen axis points along -z (downwards).\n    gp = gripper_pose()\n    # A top-down grasp: fingers squeeze along best_c[\"yaw\"], pen axis is along best_c[\"yaw\"] + pi/2.\n    # Using move_gripper with approach=[cos(yaw_pen), sin(yaw_pen), 0] aligns pen with approach?\n    # Actually, side vector is perpendicular to approach and finger_axis.\n    # If approach = [0, 0, -1], side is horizontal.\n    # If we set approach horizontal and finger_axis horizontal, side points vertically [0, 0, +/-1]!\n    # Let's set approach along world x (or y), finger_axis perpendicular in xy plane, so side is vertical.\n    yaw_f = best_c[\"yaw\"]\n    fx = math.cos(yaw_f)\n    fy = math.sin(yaw_f)\n    ax = -fy\n    ay = fx\n    # approach = [ax, ay, 0], finger_axis = [fx, fy, 0] -> side = approach x finger_axis = [0, 0, -1]\n    # Check IK\n    target_z = table_z + rim_h + 0.08\n    ik = solve_ik(hx, hy, target_z, approach=[ax, ay, 0], finger_axis=[fx, fy, 0])\n    if ik[\"reachable\"]:\n        move_gripper(hx, hy, target_z, approach=[ax, ay, 0], finger_axis=[fx, fy, 0], path=\"joint\")\n        # Lower into holder\n        move_by(dz=-0.04)\n        open_gripper()\n        retreat(dz=0.1)\n    else:\n        # Fallback: carry directly above center and lower/drop\n        carry_to(hx, hy, height=rim_h + 0.05)\n        open_gripper()\n        retreat(dz=0.12)\n\n    go_home()\n    check(\"red_pen\", \"magenta_holder\")",
