    {
     "n": 2,
     "code": "cands = grasp_candidates(\"yellow_pen\")\ncand = max(cands, key=lambda c: c[\"score\"])\ngrasp(cand)\n\nobs = observe()\nholder = obs[\"zones\"][\"magenta_holder\"]\nhx, hy, _ = holder[\"center\"]\nrim_h = holder.get(\"rim_height\", 0.08)\ntz = obs[\"table_z\"]\n\n# A long object grasped across width lies along 'side' = approach x finger_axis.\n# When fingers point down ([0, 0, -1]), side is in the horizontal plane.\n# To make the held pen point down vertically (standing), we reorient the gripper\n# so that the pen axis ('side') aligns with -z.\n# If approach = [1, 0, 0] and finger_axis = [0, 1, 0], then side = [0, 0, 1] or -z.\n# Let's test approach horizontal: approach = [0, 1, 0], finger_axis = [1, 0, 0] -> side = [0, 0, -1].\n# Along side is the pen, so side pointing [0, 0, -1] means the pen points straight down!\nik = solve_ik(hx, hy, tz + rim_h + 0.16, approach=[0, 1, 0], finger_axis=[1, 0, 0])\nif ik[\"reachable\"]:\n    app = [0, 1, 0]\n    fa = [1, 0, 0]\nelse:\n    app = [1, 0, 0]\n    fa = [0, 1, 0]\n\ncarry_to(hx, hy, height=0.25)\nmove_gripper(hx, hy, tz + rim_h + 0.15, approach=app, finger_axis=fa, path=\"line\")\nmove_by(dz=-0.08)\nopen_gripper()\nretreat(0.15)\ngo_home()\ncheck(\"yellow_pen\", \"magenta_holder\")",
