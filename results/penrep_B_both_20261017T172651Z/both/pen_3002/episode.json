     "n": 1,
     "code": "def place_on_zone_v1(obj_name, zone_name):\n    obs = observe()\n    obj = obs[\"objects\"][obj_name]\n    zone = obs[\"zones\"][zone_name]\n\n    # Check if the zone is free for the object\n    zone_free = free_spots(zone[\"name\"], obj_name)\n    if not zone_free[\"spots\"]:\n        raise RuntimeError(f\"{zone_name} is occupied or no valid spot for {obj_name}.\")\n\n    # Get grasp candidates for the object\n    candidates = grasp_candidates(obj_name)\n    if not candidates:\n        raise RuntimeError(f\"No valid grasp candidates for {obj_name}.\")\n\n    candidate = candidates[0]  # Use the first valid candidate\n\n    # Grasp the object\n    grasp_result = grasp(candidate)\n    if not grasp_result[\"holding_something\"]:\n        raise RuntimeError(f\"Failed to grasp {obj_name}.\")\n\n    # Select the first free spot in the zone\n    spot = zone_free[\"spots\"][0]\n\n    # Compute required gripper yaw to align object's long axis with zone's long axis\n    target_long_axis_yaw = zone[\"long_axis_yaw\"]\n    current_obj_long_axis_yaw = candidate[\"object_long_axis_yaw\"]\n    gripper_yaw_at_grasp = candidate[\"yaw\"]\n    required_gripper_yaw = target_long_axis_yaw + (gripper_yaw_at_grasp - current_obj_long_axis_yaw)\n\n    # Carry to the spot with correct orientation\n    carry_to(spot[\"x\"], spot[\"y\"], height=0.18, yaw=required_gripper_yaw)\n\n    # Lower until contact\n    lower_until_contact()\n\n    # Release the object\n    open_gripper()\n\n    # Retreat and verify placement\n    retreat()\n    check(obj_name, zone_name)\n\nplace_on_zone_v1(\"blue_pen\", \"green_case\")",
