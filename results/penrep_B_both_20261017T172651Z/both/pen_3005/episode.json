     "code": "obs = observe()\nobj = obs[\"objects\"][\"blue_pen\"]\nzone = obs[\"zones\"][\"green_case\"]\n\n# Check if green_case is accessible and unoccupied\nzone_free = free_spots(zone[\"name\"], \"blue_pen\")\nif not zone_free[\"spots\"]:\n    raise RuntimeError(\"green_case is occupied or no valid spot for blue_pen.\")\n\n# Get grasp candidates\ncandidates = grasp_candidates(\"blue_pen\")\nif not candidates:\n    raise RuntimeError(\"No valid grasp candidates for blue_pen.\")\n\n# Use the first candidate; adjust height and yaw for stable grasp\ncandidate = candidates[0]\ngrasp_height = 0.006  # Based on prior successful grasps\ngripper_yaw_at_grasp = candidate[\"yaw\"]\ncurrent_obj_long_axis_yaw = candidate[\"object_long_axis_yaw\"]\ntarget_long_axis_yaw = zone[\"long_axis_yaw\"]\n\n# Compute required gripper yaw to align pen's long axis with case's long axis\nrequired_gripper_yaw = target_long_axis_yaw + (gripper_yaw_at_grasp - current_obj_long_axis_yaw)\n\n# Grasp the pen\ngrasp_result = grasp(candidate)\nif not grasp_result[\"holding_something\"]:\n    raise RuntimeError(\"Failed to grasp blue_pen.\")\n\n# Select the first free spot\nspot = zone_free[\"spots\"][0]\n\n# Carry to spot with correct orientation\ncarry_to(spot[\"x\"], spot[\"y\"], height=0.18, yaw=required_gripper_yaw)\n\n# Lower until contact\nlower_until_contact()\n\n# Release the pen\nopen_gripper()\n\n# Retreat and verify\nretreat()\ncheck(\"blue_pen\", \"green_case\")",
