     "code": "obs = observe()\nobj = obs[\"objects\"][\"yellow_pen\"]\nzone = obs[\"zones\"][\"green_case\"]\n\n# Check if green_case is free and has a valid spot\nzone_free = free_spots(zone[\"name\"], obj[\"name\"])\nif not zone_free[\"spots\"]:\n    raise RuntimeError(\"No free spot in green_case for yellow_pen.\")\n\n# Get grasp candidates\ncandidates = grasp_candidates(\"yellow_pen\")\nif not candidates:\n    raise RuntimeError(\"No grasp candidates for yellow_pen.\")\n\n# Use the first candidate; ensure grasp height and yaw are appropriate\ncandidate = candidates[0]\ngrasp_height = candidate[\"height\"]\ngrasp_yaw = candidate[\"yaw\"]\n\n# Grasp the pen\ngrasp_result = grasp(candidate)\nif not grasp_result[\"holding_something\"]:\n    raise RuntimeError(\"Failed to grasp yellow_pen.\")\n\n# Compute required gripper yaw to align pen's long axis with green_case's long axis\ntarget_long_axis_yaw = zone[\"long_axis_yaw\"]\ncurrent_obj_long_axis_yaw = candidate[\"object_long_axis_yaw\"]\ngripper_yaw_at_grasp = candidate[\"yaw\"]\nrequired_gripper_yaw = target_long_axis_yaw + (gripper_yaw_at_grasp - current_obj_long_axis_yaw)\n\n# Choose the first free spot\nspot = zone_free[\"spots\"][0]\n\n# Carry to the spot with correct orientation\ncarry_to(spot[\"x\"], spot[\"y\"], height=0.18, yaw=required_gripper_yaw)\n\n# Lower until contact\nlower_until_contact()\n\n# Release the pen\nopen_gripper()\n\n# Retreat and verify\nretreat()\ncheck(\"yellow_pen\", \"green_case\")",
