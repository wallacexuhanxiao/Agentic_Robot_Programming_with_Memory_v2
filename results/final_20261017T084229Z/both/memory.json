  {
   "function": "place_on_zone_v1",
   "subgoal": "place_on_zone",
   "code": "def place_on_zone_v1(obj_name, zone_name):\n    obs = observe()\n    obj = obs[\"objects\"][obj_name]\n    zone = obs[\"zones\"][zone_name]\n    center = zone[\"center\"]\n    dx, dy = 0.0, 0.0\n    grasp_height = obj[\"height\"] / 2\n    yaw = obj[\"long_axis_yaw\"] if obj[\"footprint_long\"] < 0.08 else obj[\"short_axis_yaw\"]\n    pick(obj_name, grasp_height, yaw)\n    place(zone_name, dx, dy)",
   "expected_effect": "object resting inside the zone footprint, gripper open, arm lifted",
