    {
     "n": 2,
     "code": "# Look at current scene: purple_pen is leaning/inside holder rim (height=0.1245, top_z=0.9245, rim_height=0.08)\n# but check said satisfied: False (\"standing\": false, top_height_above_table: 0.1107, horizontal_span_m: 0.0805).\n# The pen is tilted inside the holder, not upright.\n# To make it stand upright: grasp it higher up, lift slightly, center it directly over the holder, lower it down until bottom rests on holder floor, and release.\n\nobs = observe()\npen = obs[\"objects\"][\"purple_pen\"]\nholder = obs[\"zones\"][\"magenta_holder\"]\ntable_z = obs[\"table_z\"]\n\n# Pick grasp candidate near top of the pen to re-align it\ncandidates = grasp_candidates(\"purple_pen\")\ncands = [c for c in candidates if c.get(\"fits_open_fingers\", True)]\n# Sort by height descending so we grab near the upper part of the leaning pen\ncands.sort(key=lambda c: c.get(\"height\", 0.0), reverse=True)\n\nif cands:\n    chosen = cands[0]\nelse:\n    # Fallback to geometry\n    chosen = candidates[0]\n\nres = grasp(chosen)\nif res.get(\"holding_something\", False):\n    # Move directly over the holder center\n    hx, hy = holder[\"center\"][0], holder[\"center\"][1]\n    carry_to(hx, hy, height=0.22)\n    # Lower carefully into the holder\n    lower_until_contact()\n    open_gripper()\n    retreat(0.12)\n    go_home()\n    check(\"purple_pen\", \"magenta_holder\")",
