     "n": 1,
     "code": "# Subgoal: place cyan_mug onto blue_coaster\nobs = observe()\ncoaster = obs[\"zones\"][\"blue_coaster\"]\ntarget_x, target_y = coaster[\"center\"][0], coaster[\"center\"][1]\n\n# Choose top-down grasp near the rim of the mug\ncandidates = grasp_candidates(\"cyan_mug\")\n# Filter for clear candidates, prefer grasp near the upper part of the mug (height ~ 0.058 - 0.065)\nvalid_candidates = [\n    c\n    for c in candidates\n    if c[\"fits_open_fingers\"]\n    and c.get(\"hand_clear\", True)\n    and c.get(\"fingers_clear\", True)\n]\n\nif valid_candidates:\n    # Sort to pick highest grasp height to grasp near rim safely\n    best_cand = max(valid_candidates, key=lambda c: c[\"height\"])\nelse:\n    best_cand = candidates[0]\n    best_cand[\"height\"] = max(best_cand[\"height\"], 0.058)\n\ngrasp(best_cand)\n\n# Carry to coaster, lower and release\ncarry_to(target_x, target_y, height=0.18)\nlower_until_contact()\nopen_gripper()\nretreat(dz=0.12)\ngo_home()",
