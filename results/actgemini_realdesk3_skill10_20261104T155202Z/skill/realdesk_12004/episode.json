     "code": "# Grasp yellow_paper and place it into red_bin\ncandidates = grasp_candidates(\"yellow_paper\")\nclear_candidates = [\n    c for c in candidates \n    if c.get(\"hand_clear\", True) and c.get(\"fingers_clear\", True)\n]\nchosen_candidates = clear_candidates if clear_candidates else candidates\n\n# Prefer contact-graspnet or highest score candidate\nbest_c = max(chosen_candidates, key=lambda c: (c.get(\"source\") == \"contact-graspnet\", c.get(\"score\", 0.0)))\ngrasp_res = grasp(best_c)\n\nif grasp_res.get(\"holding_something\", False):\n    obs = observe()\n    bin_zone = obs[\"zones\"][\"red_bin\"]\n    bin_center = bin_zone[\"center\"]\n    rim_h = bin_zone.get(\"rim_height\", 0.12)\n    \n    # Move safely above the bin and drop into it\n    carry_to(bin_center[0], bin_center[1], height=rim_h + 0.08)\n    open_gripper()\n    retreat(0.12)\n    go_home()",
