     "code": "# Subgoal: place purple_pen upright into magenta_holder\ncandidates = grasp_candidates(\"purple_pen\")\n# Select a candidate across the pen's short axis with good clearance\nchosen = None\nfor c in candidates:\n    if c.get(\"fits_open_fingers\", True) and c.get(\"hand_clear\", True):\n        # Prefer geometry grasp across short axis or high score\n        if c.get(\"source\") == \"geometry\" and abs(c[\"squeeze_width\"] - 0.01) < 0.015:\n            chosen = c\n            break\n\nif chosen is None:\n    # Fallback to the highest-scoring clear candidate\n    clear_cands = [c for c in candidates if c.get(\"hand_clear\", True)]\n    chosen = max(clear_cands if clear_cands else candidates, key=lambda c: c.get(\"score\", 0))\n\n# Ensure grasp height is near pen height so fingertips reach the table surface to envelop it\nchosen[\"height\"] = max(chosen[\"height\"], 0.012)\ngrasp(chosen)\n\n# Position above magenta_holder and orient pen upright\nobs = observe()\nholder = obs[\"zones\"][\"magenta_holder\"]\nhx, hy, hz = holder[\"center\"]\nrim_h = holder.get(\"rim_height\", 0.08)\n\n# Reorient pen to upright orientation above the holder and drop inside\nreorient_held_object_upright(hx, hy, hz + rim_h + 0.12)\ndrop_into_container_v2(\"purple_pen\", \"magenta_holder\", safe_z_offset=0.04)\n\ngo_home()\ncheck(\"purple_pen\", \"magenta_holder\")",
