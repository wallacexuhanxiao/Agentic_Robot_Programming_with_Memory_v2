     "code": "obs = observe()\ngreen_case = obs[\"zones\"][\"green_case\"]\nred_pen = obs[\"objects\"][\"red_pen\"]\n\n# Find grasp candidate for red_pen\ncandidates = grasp_candidates(\"red_pen\")\ncandidate = candidates[0]  # Use first candidate (highest score)\n\n# Grasp the red_pen\ngrasp_result = grasp(candidate)\nif not grasp_result[\"holding_something\"]:\n    raise RuntimeError(\"Failed to grasp red_pen\")\n\n# Find free spot in green_case for red_pen\nspots = free_spots(\"green_case\", \"red_pen\")[\"spots\"]\nif not spots:\n    raise RuntimeError(\"No free spot in green_case\")\n\nspot = spots[0]\nspot_x, spot_y = spot[\"x\"], spot[\"y\"]\nobject_long_axis_yaw = spot[\"object_long_axis_yaw\"]\n\n# Calculate required gripper yaw to align pen with case long axis\n# The pen's long axis at grasp is candidate[\"object_long_axis_yaw\"]\n# We want it to be object_long_axis_yaw after carry\n# So we need to rotate by: (object_long_axis_yaw - candidate[\"object_long_axis_yaw\"])\ndelta_yaw = object_long_axis_yaw - candidate[\"object_long_axis_yaw\"]\n\n# Carry to spot with correct orientation\ncarry_to(spot_x, spot_y, height=0.18, yaw=None)\nrotate_by(delta_yaw)\n\n# Lower until contact\nlower_until_contact()\n\n# Release\nopen_gripper()\n\n# Retreat\nretreat()\n\n# Check success\ncheck_result = check(\"red_pen\", \"green_case\")\nif not check_result[\"satisfied\"]:\n    raise RuntimeError(\"Red pen not properly placed in green_case\")",
