     "code": "candidates = grasp_candidates(\"red_pen\")\nbest_cand = None\nfor c in candidates:\n    if c.get(\"fits_open_fingers\", True):\n        best_cand = c\n        break\nif best_cand is None and candidates:\n    best_cand = candidates[0]\n\nres = grasp(best_cand)\nif not res.get(\"holding_something\", False):\n    # Retry with geometry grasp if available\n    for c in candidates:\n        if c.get(\"source\") == \"geometry\":\n            best_cand = c\n            break\n    grasp(best_cand)\n\nobs = observe()\nzone = obs[\"zones\"][\"magenta_holder\"]\nhx, hy, hz = zone[\"center\"]\nrim_h = zone.get(\"rim_height\", 0.08)\n\n# Carry high above holder\ncarry_to(hx, hy, height=rim_h + 0.15)\n\n# Tilt gripper to place pen upright into the holder\ntarget_z = hz + rim_h + 0.06\nik_pitch = solve_ik(hx, hy, target_z, approach=[1, 0, 0], finger_axis=[0, 1, 0])\nif ik_pitch.get(\"reachable\", False):\n    move_gripper(hx, hy, target_z, approach=[1, 0, 0], finger_axis=[0, 1, 0])\nelse:\n    move_gripper(hx, hy, target_z, approach=[0, 1, 0], finger_axis=[-1, 0, 0])\n\nmove_by(dz=-0.04)\nopen_gripper()\nretreat(dz=0.15)\ngo_home()\ncheck(\"red_pen\", \"magenta_holder\")",
