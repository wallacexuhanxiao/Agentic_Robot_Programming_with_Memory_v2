     "code": "# Grasp the red mug and place it onto the yellow coaster\ncands = grasp_candidates(\"red\")\n# Filter clear candidates, preferring valid fit\nclear_cands = [c for c in cands if c.get(\"hand_clear\", True) and c.get(\"fingers_clear\", True) and c.get(\"fits_open_fingers\", True)]\nif not clear_cands:\n    clear_cands = [c for c in cands if c.get(\"fits_open_fingers\", True)]\nchosen = max(clear_cands, key=lambda c: c.get(\"score\", 0))\n\nres = grasp(chosen)\nif res.get(\"holding_something\", False):\n    obs = observe()\n    yellow_zone = obs[\"zones\"][\"yellow\"]\n    target_x, target_y = yellow_zone[\"center\"][0], yellow_zone[\"center\"][1]\n    \n    carry_to(target_x, target_y, height=0.18)\n    lower_until_contact()\n    open_gripper()\n    retreat(dz=0.12)\n    go_home()\n    check(\"red\", \"yellow\")",
