     "code": "def place_on_zone_v1(obj_name, zone_name):\n    candidates = grasp_candidates(obj_name)\n    best_candidate = None\n    best_score = -1\n    for c in candidates:\n        if c[\"fits_open_fingers\"] and abs(c[\"yaw\"] - c[\"object_long_axis_yaw\"]) < 0.1:\n            if c[\"score\"] > best_score:\n                best_score = c[\"score\"]\n                best_candidate = c\n    if best_candidate is None:\n        best_candidate = candidates[0]\n\n    grasp(best_candidate)\n    if not observe()[\"gripper\"][\"holding_something\"]:\n        raise RuntimeError(f\"Failed to grasp {obj_name}\")\n\n    spots = free_spots(zone_name, obj_name)\n    if not spots[\"spots\"]:\n        raise RuntimeError(f\"No free spot in {zone_name}\")\n\n    spot = spots[\"spots\"][0]\n    target_yaw = spot[\"object_long_axis_yaw\"]\n    object_long_axis_at_grasp = best_candidate[\"object_long_axis_yaw\"]\n    delta_yaw = target_yaw - object_long_axis_at_grasp\n    rotate_by(delta_yaw)\n\n    carry_to(spot[\"x\"], spot[\"y\"], height=0.18, yaw=None)\n    lower_until_contact()\n    open_gripper()\n    retreat(dz=0.12)\n\nplace_on_zone_v1(\"blue_pen\", \"green_case\")",
