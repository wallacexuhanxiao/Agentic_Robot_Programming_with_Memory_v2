     "n": 3,
     "code": "# The object (red pen resting across magenta_holder rim) was missed because height=0.046 was inside/below the rim,\n# or the fingers collided with the holder rim when descending to center [-0.0479, 0.0516].\n# The rim height is 0.08, object top_z is 0.892 (height 0.092 above table).\n# Grasp the pen by grasping one of the ends extending beyond the rim!\nobs = observe()\nholder = obs[\"zones\"][\"magenta_holder\"]\ntable_z = obs[\"table_z\"]\ntarget_name = \"red_pen\" if \"red_pen\" in obs[\"objects\"] else \"red_mug\"\nobj = obs[\"objects\"][target_name]\n\n# Choose candidates or adjust grasp point to be away from the cup center along the pen's long axis\ncandidates = grasp_candidates(target_name)\nc = next(cand for cand in candidates if cand[\"fits_open_fingers\"])\n\n# The pen long axis is at long_axis_yaw (~ -0.038 rad, essentially along x).\n# Shift grasp position towards one end of the pen so fingers don't collide with holder rim (rim radius ~ 0.03m).\ndx = 0.045 * math.cos(obj[\"long_axis_yaw\"])\ndy = 0.045 * math.sin(obj[\"long_axis_yaw\"])\n\nc[\"x\"] = obj[\"center\"][0] + dx\nc[\"y\"] = obj[\"center\"][1] + dy\nc[\"height\"] = obj[\"top_z\"] - table_z - 0.01  # grasp near top\n\nres = grasp(c)\nif not res[\"holding_something\"]:\n    # Try the other end\n    c[\"x\"] = obj[\"center\"][0] - dx\n    c[\"y\"] = obj[\"center\"][1] - dy\n    res = grasp(c)\n\n# Now pen is held. Rise above holder\ncarry_to(holder[\"center\"][0], holder[\"center\"][1], height=0.25)\n\n# Tilt gripper to place pen upright:\n# approach along y, finger_axis along x -> side along -z (pen is vertical)\nhx, hy = holder[\"center\"][0], holder[\"center\"][1]\nmove_gripper(hx, hy - 0.04, table_z + holder[\"rim_height\"] + 0.12, approach=[0, 1, 0], finger_axis=[1, 0, 0], path=\"joint\")\n\n# Lower into holder\nmove_gripper(hx, hy - 0.04, table_z + holder[\"rim_height\"] + 0.03, approach=[0, 1, 0], finger_axis=[1, 0, 0], path=\"line\")\n\nopen_gripper()\nretreat(dz=0.15)\ngo_home()\ncheck(\"red_pen\", \"magenta_holder\")",
