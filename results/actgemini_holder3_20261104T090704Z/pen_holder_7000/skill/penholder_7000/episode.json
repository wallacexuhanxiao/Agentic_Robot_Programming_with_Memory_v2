     "code": "candidates = grasp_candidates(\"yellow_pen\")\n# Choose a candidate near the center or with good score that fits open fingers\nvalid_candidates = [c for c in candidates if c[\"fits_open_fingers\"]]\nchosen_grasp = sorted(valid_candidates, key=lambda c: c.get(\"score\", 0), reverse=True)[0]\n\ngrasp_res = grasp(chosen_grasp)\nif not grasp_res[\"holding_something\"]:\n    raise RuntimeError(\"Failed to grasp yellow pen\")\n\nobs = observe()\nholder = obs[\"zones\"][\"magenta_holder\"]\nhx, hy, hz = holder[\"center\"]\nrim_height = holder.get(\"rim_height\", 0.08)\n\n# Move above the holder at safe height\ncarry_to(hx, hy, height=rim_height + 0.18)\n\n# The pen is held horizontally across the gripper fingers (side vector).\n# To orient the pen upright (vertical), tilt the gripper so the pen becomes vertical.\n# Side vector is approach x finger_axis. \n# If we rotate gripper approach to horizontal, say [1, 0, 0] or [0, 1, 0], side can point along [0, 0, -1].\n# Specifically: if approach = [0, 1, 0] and finger_axis = [1, 0, 0], then side = [0, 1, 0] x [1, 0, 0] = [0, 0, -1] (vertical!).\n# Let's test reachability of inserting into the cup from above.\n# Cup top is at table_z + rim_height.\ntarget_z = obs[\"table_z\"] + rim_height + 0.08\napproach = [0.0, 1.0, 0.0]\nfinger_axis = [1.0, 0.0, 0.0]\n\nik_res = solve_ik(hx, hy, target_z, approach=approach, finger_axis=finger_axis)\nif not ik_res[\"reachable\"]:\n    approach = [1.0, 0.0, 0.0]\n    finger_axis = [0.0, 1.0, 0.0]\n\nmove_gripper(hx, hy, target_z, approach=approach, finger_axis=finger_axis, path=\"joint\")\n\n# Lower slightly into the holder\nlower_res = lower_until_contact()\n\nopen_gripper()\nretreat(dz=0.15)\ngo_home()\ncheck(\"yellow_pen\", \"magenta_holder\")",
