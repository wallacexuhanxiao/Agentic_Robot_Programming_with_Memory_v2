     "n": 3,
     "code": "# Grasp the red pen and insert it upright into magenta_holder\ncandidates = grasp_candidates(\"red_pen\")\nvalid = [c for c in candidates if c.get(\"fits_open_fingers\", True)]\nchosen = sorted(valid or candidates, key=lambda c: c.get(\"score\", 0), reverse=True)[0]\ngrasp(chosen)\n\nobs = observe()\nzone = obs[\"zones\"][\"magenta_holder\"]\nzx, zy, _ = zone[\"center\"]\nrim_h = zone.get(\"rim_height\", 0.08)\ntz = obs[\"table_z\"]\n\n# Move above the holder at a safe height\ncarry_to(zx, zy, height=rim_h + 0.15)\n\n# Orient gripper horizontally so the pen (held along side axis) stands vertically\ntarget_z = tz + rim_h + 0.08\napproach = [0.0, 1.0, 0.0]\nfinger_axis = [1.0, 0.0, 0.0]\n\nik = solve_ik(zx, zy, target_z, approach=approach, finger_axis=finger_axis)\nif not ik.get(\"reachable\", False):\n    approach = [1.0, 0.0, 0.0]\n    finger_axis = [0.0, 1.0, 0.0]\n\nmove_gripper(zx, zy, target_z, approach=approach, finger_axis=finger_axis, path=\"joint\")\n\n# Lower down into the holder keeping horizontal orientation\nmove_by(dz=-0.06)\n\nopen_gripper()\nretreat(dz=0.15)\ngo_home()",
