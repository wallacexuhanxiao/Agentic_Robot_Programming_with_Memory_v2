     "n": 2,
     "code": "# Look at the current scene: the pen is in/on the mug/holder lying across the rim\nobs = observe()\nobj_name = \"yellow_pen\" if \"yellow_pen\" in obs[\"objects\"] else \"yellow_mug\"\nzone_name = \"magenta_holder\"\n\n# Yellow pen was misdetected or is sitting as \"yellow_mug\" or yellow_pen\n# Let's inspect objects in obs\nif \"yellow_pen\" in obs[\"objects\"]:\n    pen_key = \"yellow_pen\"\nelif \"yellow_mug\" in obs[\"objects\"]:\n    pen_key = \"yellow_mug\"\nelse:\n    pen_key = list(obs[\"objects\"].keys())[0]\n\ncandidates = grasp_candidates(pen_key)\n# Choose a grasp candidate, preferably offset towards an end\ncand = candidates[0]\nfor c in candidates:\n    if c.get(\"fits_open_fingers\", True):\n        cand = c\n        break\n\n# Grasp near the end so the bottom can enter the holder deeply\n# Offset along long axis\ndx = math.cos(cand[\"object_long_axis_yaw\"]) * 0.045\ndy = math.sin(cand[\"object_long_axis_yaw\"]) * 0.045\ncand[\"x\"] += dx\ncand[\"y\"] += dy\n\ngrasp_res = grasp(cand)\nif not grasp_res.get(\"holding_something\", False):\n    # Try grasping at the original candidate point\n    cand[\"x\"] -= dx\n    cand[\"y\"] -= dy\n    grasp_res = grasp(cand)\n\nobs = observe()\nzone = obs[\"zones\"][zone_name]\nzx, zy, _ = zone[\"center\"]\nrim_height = zone.get(\"rim_height\", 0.082)\n\n# Lift and position above holder\ncarry_to(zx, zy, height=rim_height + 0.16)\n\n# Orient vertically: approach horizontal, finger_axis horizontal\n# so side = approach x finger_axis points down ([0, 0, -1])\ntarget_z = obs[\"table_z\"] + rim_height + 0.05\napproach = [0.0, 1.0, 0.0]\nfinger_axis = [1.0, 0.0, 0.0]\n\nik_res = solve_ik(zx, zy, target_z, approach=approach, finger_axis=finger_axis)\nif not ik_res.get(\"reachable\", False):\n    approach = [1.0, 0.0, 0.0]\n    finger_axis = [0.0, -1.0, 0.0]\n\nmove_gripper(zx, zy, target_z, approach=approach, finger_axis=finger_axis, path=\"joint\")\n\n# Lower down as much as possible into holder\nmove_by(dz=-0.04)\nopen_gripper()\nretreat(dz=0.15)\ngo_home()\ncheck(\"yellow_pen\", zone_name)",
