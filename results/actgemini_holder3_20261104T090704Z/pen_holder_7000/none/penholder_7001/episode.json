     "n": 1,
     "code": "# Grasp the yellow pen across its short axis\ncandidates = grasp_candidates(\"yellow_pen\")\n# Choose a candidate that grasps across the pen\ncandidates_fit = [c for c in candidates if c.get(\"fits_open_fingers\", True)]\nbest_candidate = max(candidates_fit, key=lambda c: c.get(\"score\", 0))\n\nres = grasp(best_candidate)\nif not res.get(\"holding_something\", False):\n    raise RuntimeError(\"Failed to grasp yellow pen\")\n\n# Move above the magenta pen holder\nobs = observe()\nholder = obs[\"zones\"][\"magenta_holder\"]\nhx, hy, hz = holder[\"center\"]\nrim_h = holder.get(\"rim_height\", 0.08)\n\n# The pen is held horizontally across the gripper fingers (side vector).\n# To place it upright into the holder, orient the gripper so the pen is vertical.\n# An approach vector horizontal (e.g. [1, 0, 0] or [0, 1, 0]) makes side vertical.\n# Let's align approach = [0, 1, 0], finger_axis = [1, 0, 0] -> side = approach x finger_axis = [0, 0, -1] (vertical).\n# First carry high above the holder to avoid collisions\ncarry_to(hx, hy, height=0.30)\n\n# Move above the holder with orientation that makes the pen vertical\n# side = approach x finger_axis.\n# approach = [0, 1, 0], finger_axis = [1, 0, 0] -> side = [0, 0, -1] (pen is along z axis)\ntarget_z = obs[\"table_z\"] + rim_h + 0.12\nmove_gripper(hx, hy, target_z, approach=[0, 1, 0], finger_axis=[1, 0, 0], path=\"joint\")\n\n# Lower down into the holder\nmove_by(dz=-0.08)\n\n# Release the pen\nopen_gripper()\n\n# Retreat up and go home to check\nretreat(dz=0.15)\ngo_home()\ncheck(\"yellow_pen\", \"magenta_holder\")",
