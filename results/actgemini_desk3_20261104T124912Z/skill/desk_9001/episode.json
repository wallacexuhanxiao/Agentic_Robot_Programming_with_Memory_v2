   "attempts": [
    {
     "n": 1,
     "code": "obs = observe()\nbook = obs[\"objects\"][\"red_book\"]\ntray = obs[\"zones\"][\"orange_tray\"]\n\ncands = grasp_candidates(\"red_book\")\n# Filter or sort candidates; we want a grasp across the short side (squeeze footprint_short) or top grasp\n# Book height is 0.025 m. Grasp height around 0.025 - 0.03 m prevents collision with table.\nvalid_cands = [c for c in cands if c.get(\"fits_open_fingers\", True)]\nvalid_cands.sort(key=lambda c: c.get(\"score\", 0), reverse=True)\n\ngrasped = False\nfor cand in valid_cands:\n    # Ensure grasp height is near top of book to avoid colliding with table\n    cand_copy = dict(cand)\n    if cand_copy[\"height\"] < 0.025:\n        cand_copy[\"height\"] = 0.025\n    res = grasp(cand_copy)\n    if res.get(\"holding_something\", False):\n        grasped = True\n        break\n\nif not grasped and valid_cands:\n    grasp(valid_cands[0])\n\n# Move above orange_tray\ntarget_x, target_y = tray[\"center\"][0], tray[\"center\"][1]\ncarry_to(target_x, target_y, height=0.18)\n\n# Lower down into the tray\nlower_until_contact()\nopen_gripper()\nretreat(dz=0.15)\ngo_home()\ncheck(\"red_book\", \"orange_tray\")",
