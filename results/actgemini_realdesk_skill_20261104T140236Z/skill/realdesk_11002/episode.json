     "n": 1,
     "code": "# Grasp cyan_book with safe grasp height to avoid table collision, then place into orange_tray\ncands = grasp_candidates(\"cyan_book\")\n# Filter and sort candidates: prefer across short side (yaw near short axis) and height around 0.025 - 0.03m\nbest_cand = None\nfor cand in sorted(cands, key=lambda c: c.get(\"score\", 0), reverse=True):\n    if cand[\"fits_open_fingers\"]:\n        best_cand = cand\n        break\n\nif best_cand is not None:\n    # Ensure grasp height doesn't hit table\n    best_cand[\"height\"] = max(best_cand[\"height\"], 0.025)\n    grasp_res = grasp(best_cand)\n\nobs = observe()\nzone = obs[\"zones\"][\"orange_tray\"]\nzone_center = zone[\"center\"]\n\n# Align book with tray: tray long axis is 0.0 rad\n# We can orient book's long axis along tray's long axis\nd_target = zone.get(\"long_axis_yaw\", 0.0)\ntarget_yaw = d_target + (best_cand[\"yaw\"] - best_cand[\"object_long_axis_yaw\"])\n\ncarry_to(zone_center[0], zone_center[1], height=0.18, yaw=target_yaw)\nlower_until_contact()\nopen_gripper()\nretreat(0.12)\ngo_home()\ncheck(\"cyan_book\", \"orange_tray\")",
