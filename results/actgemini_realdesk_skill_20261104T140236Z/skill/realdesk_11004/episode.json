     "n": 1,
     "code": "obs = observe()\nzone = obs[\"zones\"][\"magenta_holder\"]\nzone_center = zone[\"center\"]\nrim_height = zone.get(\"rim_height\", 0.08)\ntable_z = obs[\"table_z\"]\n\ncands = grasp_candidates(\"purple_pen\")\n# Grasp pen across short side at height ~ 0.012 m\ncands = [c for c in cands if c.get(\"fits_open_fingers\", True)]\ncands = sorted(cands, key=lambda c: c.get(\"score\", 0), reverse=True)\n\nfor cand in cands:\n    cand[\"height\"] = 0.012\n    res = grasp(cand)\n    if res.get(\"holding_something\", False):\n        break\n\nsafe_z = table_z + rim_height + 0.15\ncarry_to(zone_center[0], zone_center[1], height=safe_z - table_z)\n\n# Reorient pen vertically into holder\ncandidate_orientations = [\n    ([1, 0, 0], [0, 1, 0]),\n    ([0, 1, 0], [1, 0, 0]),\n    ([-1, 0, 0], [0, 1, 0]),\n    ([0, -1, 0], [1, 0, 0]),\n]\n\nchosen_app, chosen_fa = None, None\nfor app, fa in candidate_orientations:\n    ik_res = solve_ik(zone_center[0], zone_center[1], safe_z, approach=app, finger_axis=fa)\n    if ik_res.get(\"reachable\", False):\n        chosen_app, chosen_fa = app, fa\n        break\n\nif chosen_app is not None:\n    move_gripper(zone_center[0], zone_center[1], safe_z, approach=chosen_app, finger_axis=chosen_fa, path=\"line\")\n\nopen_gripper()\nretreat(dz=0.15)\ngo_home()\ncheck(\"purple_pen\", \"magenta_holder\")",
