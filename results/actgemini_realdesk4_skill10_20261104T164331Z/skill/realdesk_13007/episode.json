    {
     "n": 1,
     "code": "# Grasp purple_book and place it onto orange_tray\ncandidates = grasp_candidates(\"purple_book\")\n\n# Pick clear candidate across short side (fingers squeeze width, yaw along long axis or high clearance)\n# For book (height 0.025m), pick candidates that fit open fingers and have good clearance\nchosen = None\nfor c in candidates:\n    if c[\"fits_open_fingers\"] and c.get(\"fingers_clear\", True) and c.get(\"hand_clear\", True):\n        chosen = c\n        break\n\nif chosen is None:\n    # Fallback to the highest scoring clear candidate\n    candidates_sorted = sorted(candidates, key=lambda x: x.get(\"score\", 0), reverse=True)\n    for c in candidates_sorted:\n        if c[\"fits_open_fingers\"]:\n            chosen = c\n            break\n\n# Ensure safe grasp height to avoid colliding with table\nif chosen[\"height\"] < 0.025:\n    chosen[\"height\"] = 0.025\n\ngrasp_res = grasp(chosen)\nif grasp_res[\"holding_something\"]:\n    obs = observe()\n    tray = obs[\"zones\"][\"orange_tray\"]\n    tx, ty = tray[\"center\"][0], tray[\"center\"][1]\n    \n    # Align book with tray long axis if needed, or carry to center\n    carry_to(tx, ty, height=0.18)\n    \n    # Lower until contact with the tray surface\n    lower_until_contact()\n    open_gripper()\n    retreat(dz=0.12)\n    go_home()\n    check(\"purple_book\", \"orange_tray\")",
     "program_ok": true,
