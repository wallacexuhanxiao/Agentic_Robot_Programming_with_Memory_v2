     "code": "# Look at current scene: green_pen is lying across magenta_holder rim or tilted\nobs = observe()\nholder = obs[\"zones\"][\"magenta_holder\"]\npen = obs[\"objects\"][\"green_pen\"]\n\n# To place a pen standing upright in magenta_holder:\n# Grasp the pen near its upper end, lift it above holder, lower it down into holder, and release.\ncandidates = grasp_candidates(\"green_pen\")\nchosen = None\nfor c in candidates:\n    if c.get(\"fits_open_fingers\", True) and c.get(\"hand_clear\", True):\n        chosen = c\n        break\nif chosen is None:\n    chosen = candidates[0]\n\n# Pick near one end along the pen's long axis\ngrasp_c = dict(chosen)\n# Shift grasp point along the pen's long axis towards one end\nyaw_long = pen[\"long_axis_yaw\"]\ndx = 0.05 * math.cos(yaw_long)\ndy = 0.05 * math.sin(yaw_long)\n# Check which end is higher or grasp one end\ngrasp_c[\"x\"] = pen[\"center\"][0] + dx\ngrasp_c[\"y\"] = pen[\"center\"][1] + dy\n\ngrasp(grasp_c)\n\n# Carry above holder\nholder_center = holder[\"center\"]\nholder_rim = holder.get(\"rim_height\", 0.08)\ncarry_to(holder_center[0], holder_center[1], height=holder_rim + 0.12)\n\n# Lower into holder so the bottom end enters cup\nmove_by(dz=-0.08)\nopen_gripper()\nretreat(0.12)\ngo_home()\ncheck(\"green_pen\", \"magenta_holder\")",
